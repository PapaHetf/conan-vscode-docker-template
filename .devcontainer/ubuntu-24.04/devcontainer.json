// Dev-контейнер: Ubuntu 24.04.
// VS Code: «Dev Containers: Reopen in Container» -> выбрать вариант.
// Другой дистрибутив: скопируйте этот каталог и поменяйте BASE_IMAGE и имена ниже.
{
  "name": "C++ (Ubuntu 24.04)",
  "build": {
    "dockerfile": "../../docker/Dockerfile",
    "context": "../..",
    "args": {
      "BASE_IMAGE": "ubuntu:24.04"
    }
  },

  // Единый путь /workspace — как в docker-compose.yml и scripts/*.sh
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // Отдельный каталог сборки и кэш Conan для этого контейнера,
  // чтобы не конфликтовать со сборками на хосте и в других вариантах
  "initializeCommand": "mkdir -p build/devcontainer-ubuntu-24.04",
  "mounts": [
    "source=${localWorkspaceFolder}/build/devcontainer-ubuntu-24.04,target=/workspace/build,type=bind",
    "source=${localWorkspaceFolderBasename}-conan-devcontainer-ubuntu-24.04,target=/root/.conan2,type=volume"
  ],

  // gdb и LeakSanitizer используют ptrace
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined",
    "--env-file", "${localWorkspaceFolder}/.env"
  ],

  // Сабмодули, профиль Conan, зависимости Debug/Release, compile_commands.json
  "postCreateCommand": "./scripts/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd",
        "editorconfig.editorconfig"
      ]
    }
  },
  "remoteUser": "root"
}
