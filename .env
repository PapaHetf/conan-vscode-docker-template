# ============================================================
# Project Configuration (.env)
# ============================================================
# Этот файл используется docker-compose.yml и project-config.sh
# для получения имени проекта и версии.
#
# Переменные можно переопределить через окружение:
#   export PROJECT_NAME=my_app
#   export PROJECT_VERSION_MAJOR=1
#   export PROJECT_VERSION_MINOR=2
#   export PROJECT_VERSION_PATCH=3
# ============================================================

PROJECT_NAME=my_app
PROJECT_VERSION_MAJOR=0
PROJECT_VERSION_MINOR=1
PROJECT_VERSION_PATCH=0
# ============================================================
# Вариант сборки по умолчанию (для scripts/*.sh и docker compose)
# ============================================================
# DISTRO — имя файла из docker/variants/ без .env (ubuntu-24.04, debian-12, ...)
# ARCH   — amd64 | arm64; пусто = архитектура хоста
DISTRO=ubuntu-24.04
ARCH=
