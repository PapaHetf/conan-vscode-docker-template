{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch (GDB Local Debug)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/bin/ex_conan_app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "Build Debug",
      "miDebuggerPath": "/usr/bin/gdb"
    },
    {
      "name": "Run (Local Release)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Release/bin/ex_conan_app",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "Build Release",
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
