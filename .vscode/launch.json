{
  // Отладка gdb — внутри dev-контейнера (Dev Containers: Reopen in Container).
  // Программа и тесты собираются CMake Tools в build/Debug перед запуском.
  // Если программа не выбрана: «CMake: Set Launch/Debug Target».
  //
  // ASan под отладчиком: при ошибке gdb останавливается на месте (abort_on_error);
  // LeakSanitizer под ptrace не работает, поэтому detect_leaks=0
  // (утечки проверяются обычным запуском ./scripts/test.sh / run.sh).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: программа (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      // Аргументы программы, напр.: ["--path", "./data", "--password", "123"]
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "ASAN_OPTIONS", "value": "detect_leaks=0:abort_on_error=1" },
        { "name": "UBSAN_OPTIONS", "value": "print_stacktrace=1" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "Debug: тесты (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/bin/unit_tests",
      // Фильтр тестов, напр.: ["--gtest_filter=SampleTest.*"]
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "ASAN_OPTIONS", "value": "detect_leaks=0:abort_on_error=1" },
        { "name": "UBSAN_OPTIONS", "value": "print_stacktrace=1" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: build"
    }
  ]
}
