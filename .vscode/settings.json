{
    // CMake Tools работает через пресеты, которые генерирует Conan
    // (CMakeUserPresets.json -> build/<Type>/generators/CMakePresets.json).
    // Пресеты появляются после ./scripts/setup.sh (в devcontainer — автоматически).
    // Выбор: «CMake: Select Configure Preset» -> conan-debug / conan-release.
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,

    // clangd вместо IntelliSense от cpptools (cpptools нужен только для отладки gdb)
    "clangd.path": "clangd",
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy",
        "--header-insertion=iwyu",
        "--completion-style=detailed",
        "--pch-storage=memory"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",

    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },

    "files.associations": {
        "*.env": "properties"
    },
    "search.exclude": {
        "build/**": true,
        "libraries/**": true
    }
}
