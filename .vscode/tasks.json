{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Release",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "conan create . --build=missing -s build_type=Release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Build Debug",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "conan create . --build=missing -s build_type=Debug"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Build Release (Docker)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "docker build -t conan-builder . && docker run --rm -v $(pwd):/workspace conan-builder bash -c \"cd /workspace && conan install . --build=missing -s build_type=Release && conan build . -s build_type=Release\""
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Run (Local Release)",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "conan build . -s build_type=Release && ./build/Release/bin/ex_conan_app"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "conan install . --build=missing -s build_type=Release && conan build . -s build_type=Release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Launch (GDB Local Debug)",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "conan build . -s build_type=Debug && gdb ./build/Debug/bin/ex_conan_app"
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Launch (GDB Docker Debug)",
      "type": "shell",
      "command": "sh",
      "args": [
        "-c",
        "docker build -t conan-builder . && docker run -it --rm -v $(pwd):/workspace conan-builder bash -c \"cd /workspace && conan build . -s build_type=Debug && gdb ./build/Debug/bin/ex_conan_app\""
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf build && .venv/bin/conan remove \"*\" -c"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    }
  ]
}