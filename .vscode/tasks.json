{
  "version": "2.0.0",
  "tasks": [
    // ============================================================
    // BUILD TASKS
    // ============================================================
    {
      "label": "Build Release (Local)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && conan create . --build=missing -s build_type=Release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Build Debug (Local)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && conan create . --build=missing -s build_type=Debug"
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Build Release (Docker)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && docker build -t conan-builder . && docker run --rm -v $(pwd):/workspace -e PROJECT_NAME=$PROJECT_NAME -e PROJECT_VERSION_MAJOR=$PROJECT_VERSION_MAJOR -e PROJECT_VERSION_MINOR=$PROJECT_VERSION_MINOR -e PROJECT_VERSION_PATCH=$PROJECT_VERSION_PATCH conan-builder bash -c \"cd /workspace && conan install . --build=missing -s build_type=Release && conan build . -s build_type=Release\""
      ],
      "group": {
        "kind": "build"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    // ============================================================
    // RUN TASKS
    // ============================================================
    {
      "label": "Run Release (Local)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && conan build . -s build_type=Release && ./build/Release/bin/$TARGET_NAME"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Run Release (Docker)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && docker run --rm -v $(pwd):/workspace -e PROJECT_NAME=$PROJECT_NAME -e PROJECT_VERSION_MAJOR=$PROJECT_VERSION_MAJOR -e PROJECT_VERSION_MINOR=$PROJECT_VERSION_MINOR -e PROJECT_VERSION_PATCH=$PROJECT_VERSION_PATCH conan-builder bash -c \"cd /workspace && conan install . --build=missing -s build_type=Release && conan build . -s build_type=Release && ./build/Release/bin/$TARGET_NAME\""
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    // ============================================================
    // RUN WITH ARGUMENTS
    // ============================================================
    {
      "label": "Run Release (Local) with Args",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && conan build . -s build_type=Release && ./build/Release/bin/$TARGET_NAME ${INPUT:runArgs}"
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      },
      "inputs": [
        {
          "id": "runArgs",
          "type": "promptString",
          "description": "Arguments for the program"
        }
      ]
    },
    {
      "label": "Run Release (Docker) with Args",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && docker run --rm -v $(pwd):/workspace -e PROJECT_NAME=$PROJECT_NAME -e PROJECT_VERSION_MAJOR=$PROJECT_VERSION_MAJOR -e PROJECT_VERSION_MINOR=$PROJECT_VERSION_MINOR -e PROJECT_VERSION_PATCH=$PROJECT_VERSION_PATCH conan-builder bash -c \"cd /workspace && conan install . --build=missing -s build_type=Release && conan build . -s build_type=Release && ./build/Release/bin/$TARGET_NAME ${INPUT:runArgsDocker}\""
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      },
      "inputs": [
        {
          "id": "runArgsDocker",
          "type": "promptString",
          "description": "Arguments for the program (Docker)"
        }
      ]
    },
    // ============================================================
    // DEBUG TASKS
    // ============================================================
    {
      "label": "Launch (GDB Local Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && conan build . -s build_type=Debug && gdb ./build/Debug/bin/$TARGET_NAME"
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    {
      "label": "Launch (GDB Docker Debug)",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source project-config.sh && docker build -t conan-builder . && docker run -it --rm -v $(pwd):/workspace -e PROJECT_NAME=$PROJECT_NAME -e PROJECT_VERSION_MAJOR=$PROJECT_VERSION_MAJOR -e PROJECT_VERSION_MINOR=$PROJECT_VERSION_MINOR -e PROJECT_VERSION_PATCH=$PROJECT_VERSION_PATCH conan-builder bash -c \"cd /workspace && conan build . -s build_type=Debug && gdb ./build/Debug/bin/$TARGET_NAME\""
      ],
      "group": {
        "kind": "test"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    },
    // ============================================================
    // UTILITY TASKS
    // ============================================================
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "rm -rf build && conan remove \"*\" -c"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true
      }
    }
  ]
}